<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.example.medical.mapper.DepartmentMapper">
    <select id="selectAll" resultType="com.example.medical.entity.Department">
        select * from department order by id
    </select>
    <select id="selectById" resultType="com.example.medical.entity.Department">
        select * from department where id=#{id}
    </select>
</mapper>
