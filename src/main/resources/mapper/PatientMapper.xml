<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.example.medical.mapper.PatientMapper">
    <!-- 密码不在这里：patient 表已无 password 列，注册时同事务写入 sys_user -->
    <insert id="insert" useGeneratedKeys="true" keyProperty="id">
        insert into patient(phone,name,id_card,sex,status,create_time)
        values(#{phone},#{name},#{idCard},#{sex},1,now())
    </insert>
    <select id="selectByPhone" resultType="com.example.medical.entity.Patient">
        select * from patient where phone=#{phone}
    </select>
    <select id="selectById" resultType="com.example.medical.entity.Patient">
        select * from patient where id=#{id}
    </select>
    <select id="selectAll" resultType="com.example.medical.entity.Patient">
        select * from patient order by id desc
    </select>
    <update id="updateInfo">
        update patient set name=#{name},id_card=#{idCard},sex=#{sex} where id=#{id}
    </update>
    <update id="updateStatus">
        update patient set status=#{status} where id=#{id}
    </update>
</mapper>
