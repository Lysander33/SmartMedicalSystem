<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.example.medical.mapper.PrescriptionItemMapper">
    <insert id="insert" useGeneratedKeys="true" keyProperty="id">
        insert into prescription_item(prescription_id,medicine_id,medicine_name,spec,quantity,dosage,frequency,course,price,subtotal)
        values(#{prescriptionId},#{medicineId},#{medicineName},#{spec},#{quantity},#{dosage},#{frequency},#{course},#{price},#{subtotal})
    </insert>
    <select id="selectByPrescriptionId" resultType="com.example.medical.entity.PrescriptionItem">
        select * from prescription_item where prescription_id=#{prescriptionId}
    </select>
</mapper>
